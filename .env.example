# Synclina AI — streams answers from Gemini (falls back to built-in answers if unset)
GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Contact form: delivers to the inbox through Brevo's "Website enquiry" template.
# Without these, the form opens the visitor's email app with the message prefilled.
BREVO_API_KEY=
BREVO_TEMPLATE_ID=
# CONTACT_TO=synclinaai@gmail.com

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Search engine ownership tags (Google Search Console / Bing Webmaster Tools, "HTML tag" method: the content value only)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
