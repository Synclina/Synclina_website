# Synclina AI — streams answers from Gemini (falls back to built-in answers if unset)
GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Contact form: delivers to the inbox through Brevo's "Website enquiry" template.
# Without these, the form opens the visitor's email app with the message prefilled.
BREVO_API_KEY=
BREVO_TEMPLATE_ID=
# CONTACT_TO=synclinaai@gmail.com

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Search engine ownership tags (Google Search Console / Bing Webmaster Tools, "HTML tag" method: the content value only)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Admin area (Production only). `npm run admin:setup` creates these; see that script.
# ADMIN_PATH=
# ADMIN_PASSWORD_HASH=
# ADMIN_DOOR_HASH=
# ADMIN_TOTP_SECRET=
# ADMIN_RECOVERY_HASHES=
# FIREBASE_SERVICE_ACCOUNT_B64=
# ADMIN_ALERT_TO=synclinaai@gmail.com
# ADMIN_ALERT_SENDER=synclinaai@gmail.com
