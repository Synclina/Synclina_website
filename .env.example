# Synclina AI — streams answers from Gemini (falls back to built-in answers if unset)
GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Contact form — delivers straight to the inbox via Resend (https://resend.com).
# Without it, the form opens the visitor's email app with the message prefilled.
RESEND_API_KEY=
# CONTACT_TO=ysaisreenathreddy@gmail.com
# CONTACT_FROM=Synclina Website <onboarding@resend.dev>

NEXT_PUBLIC_SITE_URL=http://localhost:3000
